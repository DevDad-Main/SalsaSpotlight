{
  "name": "spotlight-win",
  "version": "1.2.4",
  "description": "Spotlight-style launcher and floating desktop widgets for Windows 11",
  "main": "main.js",
  "author": "DevDad-Main",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.0",
    "gridstack": "^14.0.0",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.devdad.salsaspotlight",
    "productName": "SalsaSpotlight",
    "publish": {
      "provider": "github",
      "owner": "DevDad-Main",
      "repo": "SalsaSpotlight"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "grid.js",
      "startup-batch.js",
      "preload.js",
      "indexer.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SalsaSpotlight",
      "runAfterFinish": true
    }
  }
}