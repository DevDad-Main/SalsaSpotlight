{
  "name": "spotlight-win",
  "version": "1.0.0",
  "description": "Spotlight-style launcher and floating desktop widgets for Windows 11",
  "main": "main.js",
  "author": "DevDad-Main",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.devdad.salsaspotlight",
    "productName": "SalsaSpotlight",
    "files": ["main.js", "preload.js", "indexer.js", "renderer/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "portable": {
      "artifactName": "SalsaSpotlight-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "SalsaSpotlight-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
